NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:8081
# Ilustrativa; configure credenciais locais somente em .env.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/vibra?schema=public
# Obrigatório. Substitua pelo resultado de um gerador aleatório (mínimo 32 bytes); este placeholder é inválido.
JWT_SECRET=CHANGE_ME
