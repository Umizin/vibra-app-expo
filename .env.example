# Docker Compose (PostgreSQL): substitua a senha ilustrativa por uma senha local.
POSTGRES_DB=vibra
POSTGRES_USER=vibra
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://vibra:replace-with-a-local-password@postgres:5432/vibra?schema=public

# API. Gere um segredo local com: openssl rand -hex 32
NODE_ENV=development
PORT=3001
API_PORT=3001
FRONTEND_ORIGIN=http://localhost:8081
JWT_SECRET=replace-with-at-least-32-random-bytes
# Obtenha seu client_id em https://developer.jamendo.com/v3.0
JAMENDO_CLIENT_ID=YOUR_JAMENDO_CLIENT_ID

# Expo: escolha o endereço apropriado ao dispositivo e reinicie o Expo após alterar.
# Android Emulator: http://10.0.2.2:3001
# Navegador/iOS Simulator: http://localhost:3001
# Dispositivo físico: http://<IP-LAN-do-computador>:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
